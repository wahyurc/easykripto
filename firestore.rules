rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function superadmin() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.get('superadmin', false) == true && request.auth.token.get('role', '') == 'superadmin';
    }
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true && approvedAccess(uid);
    }
    function approvedAccess(uid) {
      return superadmin() || (exists(/databases/$(database)/documents/registrations/$(uid))
        ? get(/databases/$(database)/documents/registrations/$(uid)).data.status == 'approved'
        : request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    match /registrations/{uid} {
      allow get: if superadmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if superadmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasAll(['uid','name','email','status','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','name','email','status','createdAt'])
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 150
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if superadmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','reason'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300;
      allow delete: if false;
    }
    function validAccount(uid) {
      let d = request.resource.data;
      let role = superadmin() ? 'superadmin' : 'user';
      return d.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt', 'lastSeenAt'])
        && d.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt', 'lastSeenAt'])
        && d.uid == uid && d.email == request.auth.token.email
        && d.name is string && d.name.size() <= 150 && d.role == role
        && d.createdAt is timestamp && d.createdAt <= request.time
        && d.lastSeenAt == request.time;
    }
    match /accounts/{uid} {
      allow get: if superadmin() || owner(uid);
      allow list: if superadmin();
      allow create: if owner(uid) && validAccount(uid);
      allow update: if owner(uid) && validAccount(uid) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      function validWatchId(id) {
        return id.matches('^[a-zA-Z0-9_-]{1,80}$');
      }
      function validWatch(kind, id) {
        let d = request.resource.data;
        let fields = kind == 'wallets' ? ['id','name','address','chain','alert','updatedAt'] : ['id','name','address','chain','symbol','updatedAt'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
          && validWatchId(id) && d.id == id
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.chain in ['solana','ethereum','base','bsc','robinhood']
          && d.address is string
          && (d.chain == 'solana' ? d.address.matches('^[1-9A-HJ-NP-Za-km-z]{32,44}$') : d.address.matches('^0x[0-9a-fA-F]{40}$'))
          && (kind == 'wallets' ? d.alert is bool : d.symbol is string && d.symbol.size() <= 32)
          && d.updatedAt == request.time;
      }
      match /wallets/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && validWatch('wallets',id);
        allow delete: if owner(uid) && validWatchId(id);
      }
      match /tokens/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && validWatch('tokens',id);
        allow delete: if owner(uid) && validWatchId(id);
      }
    }
    match /visitLimits/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['at','visitId'])
        && request.resource.data.at == request.time
        && request.resource.data.visitId is string
        && request.resource.data.visitId.matches('^[a-zA-Z0-9_-]{20,64}$')
        && (!exists(/databases/$(database)/documents/visitLimits/$(uid))
          || request.time >= resource.data.at + duration.value(60, 's'));
      allow list, delete: if false;
    }
    match /visits/{visitId} {
      allow read: if superadmin();
      allow create: if request.auth != null && owner(request.auth.uid)
        && visitId.matches('^[a-zA-Z0-9_-]{20,64}$')
        && getAfter(/databases/$(database)/documents/visitLimits/$(request.auth.uid)).data.at == request.time
        && getAfter(/databases/$(database)/documents/visitLimits/$(request.auth.uid)).data.visitId == visitId
        && request.resource.data.keys().hasAll(['startedAt', 'page', 'device', 'browser', 'source', 'userId'])
        && request.resource.data.keys().hasOnly(['startedAt', 'page', 'device', 'browser', 'source', 'userId'])
        && request.resource.data.startedAt == request.time
        && request.resource.data.page in ['masuk', 'ringkasan', 'peta', 'pantauan', 'aktivitas', 'superadmin']
        && request.resource.data.device in ['Handphone', 'Tablet', 'Desktop']
        && request.resource.data.browser in ['Chrome', 'Edge', 'Firefox', 'Safari', 'Lainnya']
        && request.resource.data.source is string && request.resource.data.source.size() <= 253
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
